[{"id":0,"name":"Ndjotime","parent":3,"co_parents":[],"x":2588,"y":632,"mentions":[]},{"id":1,"name":"Mana","parent":10,"co_parents":[],"x":2400,"y":633,"mentions":[355,387,389]},{"id":2,"name":"Jinda","parent":1,"co_parents":[],"x":2198,"y":634,"mentions":[]},{"id":3,"name":"Sepu","parent":7,"co_parents":[],"x":2824,"y":637,"mentions":[222]},{"id":4,"name":"Ayi","parent":5,"co_parents":[],"x":3020,"y":639,"mentions":[],"note":"The 88th ancestor of the Ngala-Dwala line, placed by the book around the 10th century BCE; the book notes the name Ayi was fully preserved among the Beti of Cameroon.","pages":[321,322,325]},{"id":5,"name":"Fapi","parent":11,"co_parents":[],"x":3189,"y":641,"mentions":[],"note":"Called Papi in the book, the 89th ancestor of the Ngala-Dwala line (also given as the 89th link in a separate name-correspondence table pairing Ngala Papi with Egyptian Pepi).","pages":[325,335]},{"id":6,"name":"Ikale","parent":null,"co_parents":[],"x":3382,"y":645,"mentions":[164,220,314,320,374],"note":"First ancestor of the Ngala-Dwala line. Counting three generations per century, Dika Akwa puts him at the end of Egypt's 17th dynasty (c. 1625–1600 BCE) and asks whether he was one of the Theban nomarchs who took pharaonic titles during the struggle against the Hyksos.","pages":[320]},{"id":7,"name":"Njotime","parent":15,"co_parents":[],"x":2806,"y":709,"mentions":[]},{"id":8,"name":"Oton","parent":0,"co_parents":[],"x":2620,"y":710,"mentions":[]},{"id":9,"name":"Kala","parent":2,"co_parents":[],"x":2212,"y":711,"mentions":[32,99,102,314,335,412]},{"id":10,"name":"Sisi","parent":18,"co_parents":[],"x":2418,"y":712,"mentions":[177,270,273]},{"id":11,"name":"Titi","parent":17,"co_parents":[],"x":3199,"y":712,"mentions":[325,337],"note":"The 90th ancestor of the Ngala-Dwala line, placed by the book around the 10th century BCE among the nobility; a separate name table also pairs Ngala Titi with Egyptian Titi.","pages":[325,337]},{"id":12,"name":"Mukunde","parent":4,"co_parents":[],"x":2970,"y":714,"mentions":[]},{"id":13,"name":"Mosi","parent":6,"co_parents":[],"x":3387,"y":722,"mentions":[93,319,320,321,329,333],"note":"The 108th ancestor in the Ngala-Dwala line; the book pairs him with Ahmose I, who expelled the Hyksos from Egypt around 1590 BCE, and elsewhere calls Mosi a name meaning 'Monday, day of the moon' in Kingala, tied to a moon cult.","pages":[320,329]},{"id":14,"name":"Mukete","parent":9,"co_parents":[],"x":2194,"y":781,"mentions":[337],"note":"Listed in the book's Ngala-Egyptian name-correspondence table, pairing the Ngala-Dwala name Mukete with the Egyptian Mesketet; the book does not give an exact generation number for this pairing.","pages":[337]},{"id":15,"name":"Sanoto","parent":24,"co_parents":[],"x":2816,"y":783,"mentions":[]},{"id":16,"name":"Dè Pi","parent":8,"co_parents":[],"x":2617,"y":784,"mentions":[]},{"id":17,"name":"Tineki","parent":26,"co_parents":[],"x":3168,"y":785,"mentions":[],"note":"Called Setineki in the book, descendant of Kupe in the Ngala-Dwala line; compared to the pharaoh Seth-Nakht.","pages":[325]},{"id":18,"name":"Ka","parent":23,"co_parents":[],"x":2428,"y":785,"mentions":[],"note":"The 53rd link in the Ngala-Dwala genealogy per the book's name-correspondence table, paired with the Egyptian name Kha.","pages":[337]},{"id":19,"name":"Die","parent":12,"co_parents":[],"x":3021,"y":785,"mentions":[]},{"id":20,"name":"Mulobi","parent":13,"co_parents":[],"x":3372,"y":791,"mentions":[320,321,433],"note":"107th/103rd ancestor of the Ngala-Dwala line (also spelled Malobi, Mulobe; European navigators wrote Monoba/Moniba). The book tentatively equates him with Amenhotep I (Jehoutimes), successor of Ahmose.","pages":[320,321]},{"id":21,"name":"Mbile","parent":14,"co_parents":[],"x":2213,"y":856,"mentions":[]},{"id":22,"name":"Makone","parent":16,"co_parents":[],"x":2598,"y":856,"mentions":[]},{"id":23,"name":"Liken","parent":29,"co_parents":[],"x":2401,"y":856,"mentions":[]},{"id":24,"name":"Manga","parent":30,"co_parents":[],"x":2818,"y":860,"mentions":[284,319,334,352,403,433]},{"id":25,"name":"Kaka","parent":19,"co_parents":[],"x":3008,"y":864,"mentions":[303,353,419]},{"id":26,"name":"Kupe","parent":33,"co_parents":[],"x":3169,"y":869,"mentions":[335],"note":"Descendant of Makale I in the Ngala-Dwala line; the book says the name is very close to Khufu (Cheops), and a separate table pairs Kupe/Koue/Kofi with Khufu.","pages":[325,335]},{"id":27,"name":"Dimodi I","parent":20,"co_parents":[],"x":3359,"y":869,"mentions":[],"note":"Part of a run of ancestors named Dimodi that the book aligns with the Thutmose kings of Egypt's 18th dynasty; this one corresponds to Thutmose I (c. 1530-1520 BCE) in the book's comparative table.","pages":[320]},{"id":28,"name":"Sela","parent":22,"co_parents":[],"x":2619,"y":936,"mentions":[]},{"id":29,"name":"Undu","parent":36,"co_parents":[],"x":2403,"y":937,"mentions":[]},{"id":30,"name":"Iya","parent":41,"co_parents":[],"x":2846,"y":938,"mentions":[]},{"id":31,"name":"Sewule","parent":21,"co_parents":[],"x":2195,"y":939,"mentions":[],"note":"Given as Sowele/Sewoule, the 46th link in the Ngala-Dwala genealogy according to the book's name-correspondence table, paired with the Egyptian name Saouré.","pages":[335]},{"id":32,"name":"Elali","parent":25,"co_parents":[],"x":3012,"y":944,"mentions":[207]},{"id":33,"name":"Makale I","parent":40,"co_parents":[],"x":3154,"y":952,"mentions":[],"note":"Son of Male I in the Ngala-Dwala genealogy; the book compares the name Makale to the pharaoh title/name Maatkare (given as 'Bmenth-Kare', 1341-1340 BCE).","pages":[325]},{"id":34,"name":"Dimodi II","parent":27,"co_parents":[],"x":3362,"y":952,"mentions":[],"note":"One of the Ngala-Dwala Dimodi generations the book equates with the Thutmose line, placed around the era of Thutmose II and Queen Hatshepsut.","pages":[320]},{"id":35,"name":"Eyad","parent":31,"co_parents":[],"x":2218,"y":1014,"mentions":[]},{"id":36,"name":"Joki","parent":48,"co_parents":[],"x":2412,"y":1015,"mentions":[]},{"id":37,"name":"Ma Leluka","parent":28,"co_parents":[],"x":2577,"y":1015,"mentions":[]},{"id":38,"name":"Dimodi III","parent":34,"co_parents":[],"x":3359,"y":1019,"mentions":[],"note":"One of the Ngala-Dwala Dimodi generations in the book's comparative table with the Thutmose kings; 'Dimodi' is glossed as meaning 'hearth/house of the moons' (January).","pages":[320,321]},{"id":39,"name":"Luma","parent":32,"co_parents":[],"x":3003,"y":1026,"mentions":[]},{"id":40,"name":"Male I","parent":43,"co_parents":[],"x":3178,"y":1026,"mentions":[323,411],"note":"The 94th ancestor of the Ngala-Dwala line, whose name the book derives from Mare/Kare (vocalized Male in Bantu languages); it lists several peoples the book claims descend from a 'Male' figure, including the Galla, Fulbe, Somali, and Sinegala lines.","pages":[318,319,323]},{"id":41,"name":"Dimodi","parent":46,"co_parents":[],"x":2814,"y":1026,"mentions":[289,320,321,325,327,329]},{"id":42,"name":"Dimodi IV","parent":38,"co_parents":[],"x":3357,"y":1100,"mentions":[321,327],"note":"The book explicitly identifies him with Thutmose IV, calling him the 102nd ancestor of the Ngala-Dwala line, the point up to which it says the Ngala and Egyptian pharaonic name-lists correspond step by step.","pages":[320,321,327]},{"id":43,"name":"Besi","parent":52,"co_parents":[],"x":3184,"y":1100,"mentions":[334,347],"note":"Called Abessi/Bessi, the 95th ancestor of the Ngala-Dwala line, whose era the book's calculations place around the 12th century BCE, paired with the reign of Seti II near the end of the 19th dynasty.","pages":[323]},{"id":44,"name":"Masi","parent":39,"co_parents":[],"x":3010,"y":1101,"mentions":[283,337,355]},{"id":45,"name":"Nsekele","parent":37,"co_parents":[],"x":2588,"y":1102,"mentions":[403],"note":"The book derives this name from Egyptian Sequenre, giving it as the 64th ancestor in the Ngala-Dwala genealogy (spelled Nsekele/Nsekde).","pages":[317]},{"id":46,"name":"Anteb","parent":51,"co_parents":[],"x":2819,"y":1102,"mentions":[]},{"id":47,"name":"Sankare","parent":35,"co_parents":[],"x":2191,"y":1102,"mentions":[317,404],"note":"The 44th direct ancestor of the Ego in the Ngala-Dwala genealogy; the book also says Sankare is the name of the greatest Wandala king (17th century, Gara origin, North Cameroon) and links it to the pharaoh Senkare/Sesostris I, noting Sangare/Sankara is also common among Mali's Fulbe.","pages":[317]},{"id":48,"name":"Kata","parent":49,"co_parents":[],"x":2406,"y":1103,"mentions":[354]},{"id":49,"name":"Mbeni Kale","parent":57,"co_parents":[],"x":2354,"y":1174,"mentions":[]},{"id":50,"name":"Kurtongo","parent":47,"co_parents":[],"x":2171,"y":1174,"mentions":[]},{"id":51,"name":"Dale","parent":58,"co_parents":[],"x":2829,"y":1177,"mentions":[207,229]},{"id":52,"name":"Etic","parent":61,"co_parents":[],"x":3198,"y":1177,"mentions":[],"note":"Called Etio in the book, the 96th ancestor of the Ngala-Dwala line, following Aku Malem in the sequence the book compares to the late-19th-dynasty pharaohs.","pages":[322,323]},{"id":53,"name":"Manana","parent":44,"co_parents":[],"x":2980,"y":1178,"mentions":[]},{"id":54,"name":"Mpantone","parent":42,"co_parents":[],"x":3355,"y":1179,"mentions":[320,321],"note":"The 101st ancestor of the Ngala-Dwala line, where the book's name-correspondence with the pharaohs breaks off; it speculates he may be a brother of Amenhotep III, on the theory that his grandson Mudeta I was a grandson of Thutmose IV.","pages":[320,321]},{"id":55,"name":"Elame I","parent":45,"co_parents":[],"x":2592,"y":1180,"mentions":[]},{"id":56,"name":"Mwamandi","parent":50,"co_parents":[],"x":2161,"y":1251,"mentions":[]},{"id":57,"name":"Mina","parent":65,"co_parents":[],"x":2406,"y":1257,"mentions":[65,314,319,402,403,435]},{"id":58,"name":"Tyi","parent":66,"co_parents":[],"x":2837,"y":1258,"mentions":[],"note":"Given as Tii, the 78th link in the Ngala-Dwala genealogy per the book's name-correspondence table, paired with the Egyptian name Tyi.","pages":[337]},{"id":59,"name":"Mbaka","parent":55,"co_parents":[],"x":2598,"y":1259,"mentions":[174]},{"id":60,"name":"Mudeta I","parent":54,"co_parents":[],"x":3373,"y":1260,"mentions":[],"note":"Called Moundeta in the book, the 100th ancestor of the Ngala-Dwala line; the book tentatively equates him with Ramesses I, said to have lived as a cousin of Tutankhamun under the regency of Ayi and General Horemheb.","pages":[321,322]},{"id":61,"name":"Aku Malem","parent":68,"co_parents":[],"x":3141,"y":1260,"mentions":[],"note":"The 97th Ngala-Dwala ancestor, tentatively paired with the pharaoh Merneptah. Per the book's oral tradition, born of a foreign mother, he withdrew from court, became a prophet/priest, and later led a migration south after unrest; the book speculates he may correspond to Ramesses II's eldest son Khaemwaset.","pages":[322,324,325]},{"id":62,"name":"Makale II","parent":53,"co_parents":[],"x":2970,"y":1263,"mentions":[]},{"id":63,"name":"Ngala II","parent":56,"co_parents":[],"x":2187,"y":1342,"mentions":[417]},{"id":64,"name":"Ngala I","parent":59,"co_parents":[],"x":2596,"y":1343,"mentions":[264,392,403]},{"id":65,"name":"Male II","parent":64,"co_parents":[],"x":2395,"y":1345,"mentions":[319,403]},{"id":66,"name":"Kame","parent":67,"co_parents":[],"x":2812,"y":1347,"mentions":[68,164,176,177,394,405]},{"id":67,"name":"Nseme","parent":62,"co_parents":[],"x":2989,"y":1347,"mentions":[337]},{"id":68,"name":"Mune Dota","parent":69,"co_parents":[],"x":3147,"y":1347,"mentions":[],"note":"Called Moundeta II in the book, the 98th Ngala-Dwala ancestor, paired speculatively with Ramesses II; father of Aku Malem by a foreign mother.","pages":[322,324]},{"id":69,"name":"Keti","parent":60,"co_parents":[],"x":3397,"y":1349,"mentions":[268,291,322,336,337,351],"note":"Called Koti, the 99th ancestor of the Ngala-Dwala line, which the book pairs with Seti I; a separate name-correspondence table also links a Keti (98th link) to the Egyptian Kheti of the 11th dynasty. The book cautions there is no proof the pairing is more than coincidence.","pages":[322,337]},{"id":70,"name":"Taaka","parent":63,"co_parents":[],"x":2201,"y":1431,"mentions":[337,411]},{"id":71,"name":"Mandenge","parent":70,"co_parents":[],"x":2166,"y":1512,"mentions":[]},{"id":72,"name":"Oli","parent":71,"co_parents":[],"x":1796,"y":1600,"mentions":[]},{"id":73,"name":"Mangala","parent":71,"co_parents":[],"x":2765,"y":1611,"mentions":[24,26,113,271,273,329]},{"id":74,"name":"Soso","parent":72,"co_parents":[],"x":1776,"y":1684,"mentions":[93,160,229,317]},{"id":75,"name":"Balali Bunama","parent":73,"co_parents":[],"x":2719,"y":1713,"branch":"Mali (Keita)","mentions":[]},{"id":76,"name":"Mbomako","parent":74,"co_parents":[],"x":1741,"y":1763,"mentions":[411]},{"id":77,"name":"Lawalo","parent":75,"co_parents":[],"x":2655,"y":1814,"mentions":[]},{"id":78,"name":"Kulibali","parent":75,"co_parents":[],"x":2914,"y":1816,"mentions":[]},{"id":79,"name":"Ngole","parent":76,"co_parents":[],"x":1768,"y":1844,"mentions":[222,411]},{"id":80,"name":"Batu","parent":79,"co_parents":[],"x":1776,"y":1922,"mentions":[80,402]},{"id":81,"name":"Mbu","parent":80,"co_parents":[],"x":1777,"y":1992,"mentions":[]},{"id":82,"name":"Kota","parent":81,"co_parents":[],"x":1772,"y":2065,"mentions":[15,412,413,417]},{"id":83,"name":"Ngala II","parent":81,"co_parents":[],"x":2606,"y":2070,"mentions":[417]},{"id":84,"name":"Ngala","parent":82,"co_parents":[],"x":1767,"y":2141,"mentions":[319,321,411,413,428,431]},{"id":85,"name":"Nsugan","parent":83,"co_parents":[],"x":2606,"y":2142,"mentions":[]},{"id":86,"name":"Ndiaye (Njai)","parent":85,"co_parents":[],"x":2574,"y":2208,"branch":"Jolof (Wolof)","mentions":[]},{"id":87,"name":"Tukuru","parent":84,"co_parents":[],"x":1756,"y":2219,"mentions":[93,416]},{"id":88,"name":"Yala Ndongo","parent":86,"co_parents":[],"x":2575,"y":2279,"mentions":[]},{"id":89,"name":"Dowa","parent":87,"co_parents":[],"x":1771,"y":2297,"mentions":[433]},{"id":90,"name":"Mar Djabi Ndiaye (Ngalambu Djolof)","parent":88,"co_parents":[],"x":2544,"y":2345,"mentions":[]},{"id":91,"name":"Sopo","parent":89,"co_parents":[],"x":1771,"y":2373,"mentions":[350,413,428,433]},{"id":92,"name":"Modi","parent":91,"co_parents":[],"x":1778,"y":2443,"mentions":[150,329,413,428,431,433],"note":"The book names him Modi Sopo, the celebrated generalissimo of Wangara, with one known son, Mbe, at the dawn of the 12th century. The chart draws Sopo and Modi as two generations.","pages":[428]},{"id":93,"name":"Mbe","parent":92,"co_parents":[],"x":1784,"y":2511,"mentions":[428,431],"note":"Son of Modi Sopo, early 12th century. Father of three sons who founded three branches: Kongo, ancestor of the Ngala of south-central Africa; Muyenya (Muwenya), probable ancestor of the Igala of Nigeria; and Alé, ancestor of the Ngala fraction of the Wandala.","pages":[428]},{"id":94,"name":"Alé","parent":93,"co_parents":[],"x":2347,"y":2576,"mentions":[],"note":"Son of Mbe and ancestor of the Ngala fraction of the Wandala. A Gara merchant who went north and operated in Bornu; the heads of his family were successively called “the Egyptian merchant”. His line: Sosso, Djilé, Soka Wandala, then Dawa.","pages":[428,431]},{"id":95,"name":"Muyenya","parent":93,"co_parents":[],"x":1812,"y":2580,"mentions":[428],"note":"Son of Mbe (the book spells him Muwenya); probable ancestor of the Igala of Nigeria.","pages":[428]},{"id":96,"name":"Kongo Matadi","parent":93,"co_parents":[],"x":1151,"y":2582,"mentions":[],"note":"Son of Mbe; ancestor of the Ngala of southern-central Africa.","pages":[428]},{"id":97,"name":"Soso","parent":94,"co_parents":[],"x":2331,"y":2637,"mentions":[93,160,229,317],"note":"Son of Alé in the book's Wandala genealogy; father of Djilé.","pages":[428]},{"id":98,"name":"Igala","parent":95,"co_parents":[],"x":1848,"y":2652,"mentions":[64,99,411,413,414,428],"note":"In the book's genealogical chart, Igala appears as a generation between Muwenya and Oraniyan (the traditional founder of the Benin dynasty), consistent with the text's claim that Muwenya is the probable ancestor of Nigeria's Igala people. The chart is faint/OCR-garbled, so treat the exact placement cautiously.","pages":[428,433]},{"id":99,"name":"Ngangala","parent":96,"co_parents":[],"x":799,"y":2678,"mentions":[64,87,89,90,99,419]},{"id":100,"name":"Ewanjè","parent":96,"co_parents":[],"x":1265,"y":2678,"mentions":[414]},{"id":101,"name":"Djilé","parent":97,"co_parents":[],"x":2340,"y":2706,"mentions":[428,431,433,434],"note":"Son of Soso (Sosso); father of Soka. Part of the Wandala royal line descending from Alé.","pages":[428]},{"id":102,"name":"Oraniyan","parent":98,"co_parents":[],"x":1811,"y":2721,"branch":"Benin (Oba)","mentions":[413,414]},{"id":103,"name":"Bangi","parent":100,"co_parents":[],"x":1624,"y":2752,"mentions":[]},{"id":104,"name":"Sango","parent":100,"co_parents":[],"x":1274,"y":2754,"mentions":[79,102,361,394,433]},{"id":105,"name":"Ekande","parent":100,"co_parents":[],"x":1443,"y":2754,"mentions":[303,351]},{"id":106,"name":"Mahénjama","parent":100,"co_parents":[],"x":949,"y":2757,"mentions":[414]},{"id":107,"name":"Soka","parent":101,"co_parents":[],"x":2337,"y":2774,"mentions":[428,433],"note":"The book's own sentence names Djilé's son as a single figure, 'Soka Wandala', father of Dawa - it does not clearly separate 'Soka' and 'Wandala' into two generations the way this tree does; treat the generation count here with caution.","pages":[428]},{"id":108,"name":"Eweka","parent":102,"co_parents":[],"x":1835,"y":2789,"mentions":[413,433]},{"id":109,"name":"Mumba","parent":105,"co_parents":[],"x":1444,"y":2825,"mentions":[]},{"id":110,"name":"Liongè","parent":106,"co_parents":[],"x":979,"y":2838,"mentions":[414,433]},{"id":111,"name":"Wandala","parent":107,"co_parents":[],"x":2308,"y":2839,"mentions":[160,317,411,414,428,431],"note":"Per the book's phrasing, 'Soka Wandala' appears to be one figure (son of Djilé, father of Dawa) rather than two distinct generations; this tree's split into separate Soka and Wandala entries is not clearly supported by the book's sentence structure.","pages":[428]},{"id":112,"name":"Eyen Milten","parent":108,"co_parents":[],"x":1789,"y":2863,"mentions":[]},{"id":113,"name":"Endongo","parent":109,"co_parents":[],"x":1255,"y":2904,"mentions":[]},{"id":114,"name":"Ombèke","parent":109,"co_parents":[],"x":1440,"y":2904,"mentions":[]},{"id":115,"name":"Dawa","parent":111,"co_parents":[],"x":2333,"y":2908,"mentions":[160,428]},{"id":116,"name":"Diola","parent":110,"co_parents":[],"x":991,"y":2914,"mentions":[412,417]},{"id":117,"name":"Ewedo","parent":112,"co_parents":[],"x":1830,"y":2946,"mentions":[433]},{"id":118,"name":"Ajia Makua","parent":115,"co_parents":[],"x":2298,"y":2971,"mentions":[]},{"id":119,"name":"Muktali","parent":116,"co_parents":[],"x":980,"y":2985,"mentions":[]},{"id":120,"name":"Ogala","parent":117,"co_parents":[],"x":1833,"y":3019,"mentions":[]},{"id":121,"name":"Sanda","parent":118,"co_parents":[],"x":2039,"y":3039,"branch":"Kanem–Bornu (Sayfawa)","mentions":[428,431,433],"note":"Daughter of Dawa (also called Sukda) and sister of Adjara. With Kaya (Gaya), of Toumagari blood, she had Djilé II, the first Apfalaska (prince) of Mandara, at the end of the 13th or start of the 14th century. She is the 20th direct ancestor of Sultan Hamidou Oumar of Mandara.","pages":[428,431]},{"id":122,"name":"Adjara","parent":118,"co_parents":[],"x":2560,"y":3043,"mentions":[428,430,431],"note":"Son of Dawa and brother of Sanda. He is the 20th direct ancestor of the Bamum royal line (21st of the Bakpak Binkira lines).","pages":[428,431]},{"id":123,"name":"Bwélé","parent":119,"co_parents":[],"x":990,"y":3068,"mentions":[363]},{"id":124,"name":"Oyen","parent":120,"co_parents":[],"x":1836,"y":3093,"mentions":[]},{"id":125,"name":"Apfalaska","parent":121,"co_parents":[],"x":2020,"y":3113,"mentions":[428,431,433],"note":"“Apfalaska” is a title meaning prince, borne by Djilé II, the son of Sanda and Kaya. The chart draws it as its own name.","pages":[428,431]},{"id":126,"name":"Ayoka","parent":122,"co_parents":[],"x":2566,"y":3119,"mentions":[15,160,377,431,433,434],"note":"Son of Adjara per the book; father of Issedi (called 'the Egyptian' in Bamum tradition), and a contemporary of Djilé II, the first Apfalaska of Mandara.","pages":[431]},{"id":127,"name":"Manela","parent":123,"co_parents":[],"x":984,"y":3136,"mentions":[]},{"id":128,"name":"Ewodaré","parent":124,"co_parents":[],"x":1806,"y":3164,"mentions":[]},{"id":129,"name":"Djilé","parent":125,"co_parents":[],"x":2068,"y":3185,"mentions":[428,431,433,434],"note":"Djilé II, the first Apfalaska of Mandara. Three branches descend from him and supplied the dynasties of Mora, Mounio, Karowa and Dikwa.","pages":[428,431]},{"id":130,"name":"Djilé","parent":126,"co_parents":[],"x":2472,"y":3205,"mentions":[428,431,433,434],"note":"Called Djilé III in the book's account of Mforifum's ancestry, son of Ayoka; father of Kiwa.","pages":[434]},{"id":131,"name":"Essedi","parent":126,"co_parents":[],"x":2677,"y":3205,"spouses":[132],"mentions":[431,432,434],"note":"Issedi, son of Ayoka and grandson of Adjara: “the Egyptian” of Bamum tradition, eighth direct descendant of Alé, 14th century (traditions give c. 1394). He married Nebijou and left Bornu to settle among the Mboum.","pages":[431,432,434]},{"id":132,"name":"Nebijou","parent":null,"co_parents":[],"x":2835,"y":3206,"spouses":[131],"mentions":[430,431,434],"note":"Wife of Essedi. Their three daughters were Nsien, Metapen and Mbupwet.","pages":[431,434]},{"id":133,"name":"Ngoso","parent":127,"co_parents":[],"x":989,"y":3217,"mentions":[]},{"id":134,"name":"Tukuru","parent":127,"co_parents":[],"x":1516,"y":3217,"mentions":[93,416]},{"id":135,"name":"Orloa","parent":128,"co_parents":[],"x":1830,"y":3240,"mentions":[]},{"id":136,"name":"Matchi","parent":129,"co_parents":[],"x":2052,"y":3260,"mentions":[]},{"id":137,"name":"Kiwa","parent":130,"co_parents":[],"x":2461,"y":3277,"mentions":[433,434],"note":"Descendant of Ayoka via Djilé III in the book's account of Mforifum's ancestry; father of Nguti.","pages":[434]},{"id":138,"name":"Metapen","parent":131,"co_parents":[132],"x":2757,"y":3278,"mentions":[430,434],"note":"Second daughter of Essedi and Nebijou; mother of the Mbang royal branch.","pages":[434]},{"id":139,"name":"Nsien","parent":131,"co_parents":[132],"x":2609,"y":3279,"mentions":[430,434],"note":"Daughter of Essedi and Nebijou. Bamum history makes her the mother of the Mboum royal branch of Ngan-Ha; one version makes her, with Gang-Afou, the mother of Nji Mboum II, builder of the Rifoum empire.","pages":[434]},{"id":140,"name":"Mbupwet","parent":131,"co_parents":[132],"x":2976,"y":3281,"spouses":[141],"mentions":[434],"note":"Third daughter of Essedi and Nebijou (Mbouepouet). She had three sons: Mbouon, Kayi and Nyimbou.","pages":[434]},{"id":141,"name":"Mbum Ngan Ha","parent":null,"co_parents":[],"x":3189,"y":3283,"spouses":[140],"mentions":[]},{"id":142,"name":"Diketi","parent":133,"co_parents":[],"x":996,"y":3293,"mentions":[15,322]},{"id":143,"name":"Sé","parent":134,"co_parents":[],"x":1555,"y":3298,"mentions":[]},{"id":144,"name":"Essingié","parent":135,"co_parents":[],"x":1807,"y":3321,"mentions":[]},{"id":145,"name":"Amiri Biri","parent":136,"co_parents":[],"x":2022,"y":3336,"mentions":[]},{"id":146,"name":"Nyimbu","parent":140,"co_parents":[141],"x":2896,"y":3346,"mentions":[434],"note":"Son of Mbupwet. The only one of the three brothers to marry back into the “Egyptian merchants”. His elder daughter was Yen, the younger Hosun (Hossoum).","pages":[434]},{"id":147,"name":"Kayi","parent":140,"co_parents":[141],"x":3133,"y":3353,"mentions":[434],"note":"Youngest ('le dernier') of Mbupwet's three sons in the book's Bamum origin account (Mbouon the eldest, Nyimbou the second, Kai the youngest).","pages":[430]},{"id":148,"name":"Nguti","parent":137,"co_parents":[],"x":2401,"y":3355,"spouses":[149],"mentions":[433,434],"note":"Son of Kiwa; married Ntuno, and their son was Mforifum, who through this line descended from Ayoka.","pages":[434]},{"id":149,"name":"Ntuno","parent":137,"co_parents":[],"x":2535,"y":3355,"spouses":[148],"mentions":[434],"note":"Wife of Nguti (not his daughter, despite this tree's parent link to Kiwa); mother of Mforifum.","pages":[434]},{"id":150,"name":"Mbon Papi","parent":140,"co_parents":[141],"x":3339,"y":3358,"mentions":[],"note":"Likely the book's 'Mbouon', eldest of Mbupwet's three sons; the book says he later led the family from their first village to found the settlement of Papi'rien after about 60 years.","pages":[430]},{"id":151,"name":"Mulongo","parent":143,"co_parents":[],"x":1502,"y":3372,"mentions":[]},{"id":152,"name":"Bésè","parent":142,"co_parents":[],"x":1006,"y":3373,"mentions":[234]},{"id":153,"name":"Olobuya","parent":144,"co_parents":[],"x":1807,"y":3393,"mentions":[]},{"id":154,"name":"Hosun","parent":146,"co_parents":[],"x":3018,"y":3406,"mentions":[160,434]},{"id":155,"name":"Yen","parent":146,"co_parents":[],"x":2823,"y":3416,"spouses":[156],"mentions":[],"note":"Elder DAUGHTER of Nyimbu. She married Mforifum (Mfenrifou); since both descended from Ayoka, the book calls it an endogamous union. Their children: a daughter, Ndjiason, and four sons: Nditam, Sow, Ncharé and Mbam.","pages":[434]},{"id":156,"name":"Mforifum","parent":148,"co_parents":[149],"x":2450,"y":3416,"spouses":[155],"mentions":[434],"note":"Mfenrifou, son of Nguti and his wife Ntuno. Through Kiwa and Djilé III he descends from Ayoka, like his wife Yen.","pages":[434]},{"id":157,"name":"Aldawa Bara","parent":145,"co_parents":[],"x":2002,"y":3416,"mentions":[]},{"id":158,"name":"Mbongo","parent":152,"co_parents":[],"x":977,"y":3445,"mentions":[156,234,424,426]},{"id":159,"name":"Ngo","parent":151,"co_parents":[],"x":1544,"y":3451,"mentions":[]},{"id":160,"name":"Sow","parent":156,"co_parents":[155],"x":3317,"y":3470,"men